# 값은 비워둠. 실제 .env 는 권한 600, git 제외.
RRA_DB_PATH=data/rra.sqlite
RRA_RUNS_DIR=runs
RRA_CONFIG_DIR=config
RRA_LLM_PROVIDER=mlx            # 기본 provider: mlx | openai | gemini (단계별 provider 는 config/llm.yaml stages)
RRA_LLM_BASE_URL=http://127.0.0.1:8080/v1
RRA_LLM_API_KEY=none
RRA_GEMINI_API_KEY=                # Gemini 4 Argon (검토 단계). 비우면 검토를 건너뜀
# ScienceON(KISTI API Gateway): 활용신청 → client_id + 32자 인증키, 호출 기기의 MAC 을 ScienceON 에 등록.
# MAC 은 기기마다 다르므로 개발 MacBook·배포 Mac mini 의 .env 를 따로 둔다 (docs/external-apis.md).
RRA_SCIENCEON_CLIENT_ID=
RRA_SCIENCEON_KEY=               # 32자 인증키
RRA_SCIENCEON_MAC=               # 이 기기의 MAC (AA-BB-CC-DD-EE-FF). macOS: ifconfig en0 | grep ether
RRA_KIPRIS_KEY=                  # KIPRIS Plus accessKey (plus.kipris.or.kr 활용신청: 특허·실용신안 자유검색)
RRA_OPENALEX_MAILTO=             # OpenAlex polite pool 이메일 (선택). 비우면 익명 풀로 동작
RRA_OPENALEX_API_KEY=            # OpenAlex 무료 API 키 (선택, openalex.org/settings/api). 없어도 page 페이징으로 수집
RRA_NTIS_KEY=                    # NTIS rndopen apprvKey (ntis.go.kr OpenAPI 활용신청: 과제검색 — 소속기관 등록 필요)
RRA_API_TOKEN=                  # 웹 UI·REST 관리 토큰 (G) — 없으면 ui/api 기동 거부
RRA_API_HOST=127.0.0.1          # REST 바인딩. 외부 공개는 HTTPS 역프록시 뒤에서만 (deploy/README.md)
RRA_API_PORT=8000
RRA_FAKE_LLM=0                  # 1 이면 가짜 모드(가짜 LLM·메모리 저장소, e2e·스키마 전용). 운영 금지
RRA_STATIC_DIR=web/dist         # 프론트엔드 빌드 산출물. 없으면 "/" 는 404
