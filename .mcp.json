{
  "mcpServers": {
    "rra": {
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "rra.entrypoints.mcp.server",
        "--transport",
        "stdio"
      ],
      "env": {
        "RRA_CONFIG_DIR": "config"
      }
    },
    "rra-write": {
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "rra.entrypoints.mcp.server",
        "--transport",
        "stdio",
        "--enable-generate"
      ],
      "env": {
        "RRA_CONFIG_DIR": "config"
      }
    }
  }
}
